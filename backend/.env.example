# Porta exigida pelo enunciado
PORT=9000

# Banco (os defaults batem com o docker-compose)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=nutri
DATABASE_PASSWORD=nutri
DATABASE_NAME=nutri

# LLM — provedor escolhido no boot: Anthropic, depois Gemini, depois regras.
# Sem nenhuma chave a API continua respondendo, com source="rules".
# Gemini tem free tier no Google AI Studio: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
